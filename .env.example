# Configuración de Producción MyPOS Lite para cPanel
# Copia este archivo como .env en /home/zylajdcb/lite.mypos.cl/.env

MYPOSLITE_LOCAL_DEMO=1
MYPOSLITE_DOMAIN=lite.mypos.cl
MYPOSLITE_PUBLIC_URL=https://lite.mypos.cl

# Base de datos en cPanel (Crear en cPanel -> Bases de datos MySQL)
# Ejemplo: zylajdcb_lite
MYPOSLITE_DB_DSN=mysql:host=localhost;dbname=zylajdcb_lite;charset=utf8mb4
MYPOSLITE_DB_USER=zylajdcb_liteuser
MYPOSLITE_DB_PASSWORD=CAMBIAR_POR_TU_PASSWORD_DE_BD

# Cifrado DTE (usado también como token para https://lite.mypos.cl/api/migrar.php?token=...)
MYPOSLITE_DTE_SECRET=013e0211193a0b0e755ca28a501fb6649cbd41807225c554daa60d4ae8e41888
MYPOSLITE_STORAGE_SECRET=9294c9fcd99ab4e5652b05614830b574192995bf4cbc4a6465e7ed6e73585c5f
